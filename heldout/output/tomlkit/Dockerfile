# syntax=docker/dockerfile:1
#
# Generated by okfpipe (stage 1). Reproducibility notes:
#   * base image pinned by digest, not by a moving tag
#   * dependencies installed from a fully pinned lock with --require-hashes
#   * build backends pinned too (poetry-core>=1.0.0a9), so --no-build-isolation is safe
#
FROM python@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

LABEL org.opencontainers.image.title="tomlkit"
LABEL org.opencontainers.image.description="Hygiene-transformed by okfpipe"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    TZ=UTC

WORKDIR /app

# Dependency layer first: it only re-runs when the lock actually changes.
COPY requirements.lock ./requirements.lock
RUN pip install --require-hashes -r requirements.lock

COPY . /app

# --no-deps: the lock is the single source of truth for versions.
# --no-build-isolation: build backends are already pinned above.
RUN pip install --no-deps --no-build-isolation -e .

# Run as a non-root user; tests that need to write get an owned tree.
RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

CMD ["./run-tests.sh"]
